    @Column(precision = 19, scale = 4)
    private BigDecimal dayHigh;

    @Column(precision = 19, scale = 4)
    private BigDecimal dayLow;

    @Column(precision = 19, scale = 4)
    private BigDecimal previousClose;

    private LocalDate lastTradingDate;
}
